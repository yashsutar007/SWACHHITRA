# SWACHHITRA environment template
# Copy this file to the project root as .env for local development.
# Never commit the real .env file or share its contents.

NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5000
TRUST_PROXY=0
# Local development example only. Generate a separate random secret for every environment.
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-48-characters-long
SESSION_TTL_HOURS=8

DB_HOST=localhost
DB_PORT=3306
# root is acceptable for a local-only installation; use a dedicated database user in production.
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=swachhitra
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Real SMTP details are mandatory when NODE_ENV=production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="SWACHHITRA <no-reply@example.com>"

# Local development only. Never set true in production.
ALLOW_DEV_EMAIL_LINKS=true
