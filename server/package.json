    "check:deploy-config:production": "node scripts/check-deployment-config.js --production",
    "test:deployment": "node tests/deployment-readiness.test.js",
    "test:inspector": "node tests/inspector-regression.test.js",
    "test:driver": "node tests/driver-regression.test.js",
    "test:staff-account": "node tests/staff-account-provisioning.test.js",
    "test:static": "node tests/ward-creation-regression.test.js && node tests/profile-routing-regression.test.js && node tests/staff-account-provisioning.test.js && node tests/driver-regression.test.js && node tests/deputy-commissioner.test.js",
    "test:staff-recovery": "node tests/staff-password-recovery.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.0",
