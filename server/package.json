{
  "name": "swachhitra-server",
  "version": "2.0.0",
  "private": true,
  "description": "SWACHHITRA backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "create-user": "node scripts/createUser.js",
    "test:assistant": "node tests/assistant-regression.test.js",
